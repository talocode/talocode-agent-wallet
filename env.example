# Copy to a local secret store. Do not commit the copy.
# None of these are required for the embedded preview.

# Postgres connection for a deployed app. Unset locally uses embedded Postgres.
DATABASE_URL=

# Public origin of this app, for example https://agent-wallet.talocode.site
BETTER_AUTH_URL=

# Session signing secret. Generate a long random value for a real deploy.
BETTER_AUTH_SECRET=

# Optional broker client. The preview has a built-in fallback.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# MCP and SDK examples. Create the key in the app. Never commit a real tk_ value.
TALOCODE_API_KEY=
TALOCODE_BASE_URL=http://127.0.0.1:8080
